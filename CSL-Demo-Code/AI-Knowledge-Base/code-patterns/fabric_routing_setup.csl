// CSL Code Pattern: Fabric Routing Setup
// Set up color routing for PE-to-PE communication.
// SDK Version: 1.4.0 | Works on WSE-2 and WSE-3

// === layout.csl ===
// This shows how to configure colors for east-west data flow.

// In layout.csl comptime block:
// const my_color = @get_color(0);
//
// For PE sending EAST:
// @set_color_config(sender_pe, .{
//   .routes = .{ .rx = .{ RAMP }, .tx = .{ EAST } },
// });
//
// For PE receiving from WEST:
// @set_color_config(receiver_pe, .{
//   .routes = .{ .rx = .{ WEST }, .tx = .{ RAMP } },
// });

// === pe_program.csl (sender) ===
param memcpy_params: comptime_struct;
param send_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const send_oq: output_queue = @get_output_queue(2);

var data = @zeros([10]f32);

fn send_data() void {
    const out_dsd = @get_dsd(fabout_dsd, .{
        .extent = 10,
        .fabric_color = send_color,
        .output_queue = send_oq,
    });
    const mem_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{10} -> data[i] });
    @fmovs(out_dsd, mem_dsd, .{ .async = true });
    sys_mod.unblock_cmd_stream();
}

comptime {
    if (@is_arch("wse3")) {
        @initialize_queue(send_oq, .{ .color = send_color });
    }
    @export_symbol(send_data);
}

