// CSL Code Pattern: Block/Unblock Synchronization
// Process elements one-at-a-time from a stream with back-pressure.
// SDK Version: 1.4.0 | Works on WSE-2 and WSE-3

param memcpy_params: comptime_struct;
param recv_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

const recv_iq: input_queue = @get_input_queue(2);
const recv_oq: output_queue = @get_output_queue(2);

// data_task_id: WSE-2 uses color, WSE-3 uses input_queue
const process_task_id: data_task_id =
    if      (@is_arch("wse2")) @get_data_task_id(recv_color)
    else if (@is_arch("wse3")) @get_data_task_id(recv_iq);

var result: [1]f32 = .{0.0};

const result_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> result[i] });
const d2h_dsd = @get_dsd(fabout_dsd, .{
    .extent = 1,
    .fabric_color = sys_mod.MEMCPYD2H_1,
    .output_queue = @get_output_queue(3),
});

// Each incoming wavelet triggers this task.
// @block prevents the next wavelet from firing until we're done.
task process_task(datum: f32) void {
    @block(process_task_id);  // Block: no more wavelets until unblocked

    // Process: cube the incoming value
    result[0] = datum * datum * datum;

    // Send result to host; auto-unblock when D2H completes
    @fmovs(d2h_dsd, result_dsd, .{
        .async = true,
        .unblock = process_task,  // Re-enable task on completion
    });
}

comptime {
    @bind_data_task(process_task, process_task_id);

    if (@is_arch("wse3")) {
        @initialize_queue(recv_iq, .{ .color = recv_color });
        @initialize_queue(recv_oq, .{ .color = recv_color });
        @initialize_queue(@get_output_queue(3), .{ .color = sys_mod.MEMCPYD2H_1 });
    }
}
