var Z_tile: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_Z: [*]f16 = &Z_tile;
var Z_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &Z_tile, .extent = bsz * dim_p_pe });

var ptr_debug: [*]f16 = &X_tile;


// -------------------------------------------------------------------------- //
// ------------------------------ Decode Funcs ------------------------------ //
// -------------------------------------------------------------------------- //

fn rmsnorm_x() void {
    @load_to_dsr(dest_dsr_1, X_tmp_dsd);
    @load_to_dsr(src0_dsr_1, X_dsd);
    @load_to_dsr(src1_dsr_1, X_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);

    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_tmp);
    @load_to_dsr(src1_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        sum = 0.0;
        @faddh(ptr_sum, sum, src1_dsr_1);
        local_sum[b] = sum;
    }

    comm_mod.all_reduce_bsz(py, quotient_y, remainder_y, ptr_local_sum);

    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_norm);
    dim_p_pe_dsd_2 = @set_dsd_base_addr(dim_p_pe_dsd_2, ptr_X_tmp);
    @load_to_dsr(dest_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true});
    @load_to_dsr(src0_dsr_1, dim_p_pe_dsd_2, .{ .save_address = true});
    @load_to_dsr(src1_dsr_1, W_dsd, .{ .save_address = false});
    for (@range(i16, bsz)) |b| {
        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    }

    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_norm);
    @load_to_dsr(dest_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true});
    @load_to_dsr(src0_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true});
    @map(fmulh_norm_func, local_sum_dsd);
}

fn xq_matvec_mult() void {
    @fmovh(Q_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X); // ptr_X_norm);

    ptr_right_matrix = &Q_weight_tile;

    // out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_Q);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);

    Kt = dim_p_pe;
    Nt = dim_p_pe;

    vecmat_computation();

    // comm_mod.all_reduce_bsz_dim(py, quotient_y, remainder_y, ptr_Q);
}

fn xk_matvec_mult() void {
    @fmovh(K_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X); // ptr_X_norm);

    ptr_right_matrix = &K_weight_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz*dim_p_pe, f16);

    Kt = dim_p_pe;
    Nt = kv_dim_p_pe;

    vecmat_computation();
}

fn xv_matvec_mult() void {
    @fmovh(V_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X); // ptr_X_norm);

    ptr_right_matrix = &V_weight_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz*(dim_p_pe + kv_dim_p_pe), f16);

    Kt = dim_p_pe;
    Nt = kv_dim_p_pe;

    vecmat_computation();
}

fn xq_rope() void {
    X_even_dsd = @set_dsd_base_addr(X_even_dsd, ptr_QKV_tile);
    X_odd_dsd = @set_dsd_base_addr(X_odd_dsd, ptr_QKV_tile);

    @load_to_dsr(dest_dsr_1, X_tmp_1_dsd);
    @load_to_dsr(dest_dsr_2, X_tmp_2_dsd);
    @load_to_dsr(dest_dsr_3, X_tmp_3_dsd);
    @load_to_dsr(dest_dsr_4, X_tmp_4_dsd);

    @load_to_dsr(src1_dsr_1, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_2, freqs_sin_dsd);
    @load_to_dsr(src1_dsr_3, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_4, freqs_sin_dsd);

    for (@range(i16, bsz)) |b| {

        @load_to_dsr(src0_dsr_1, X_odd_dsd);
        @load_to_dsr(src0_dsr_2, X_even_dsd);
        @load_to_dsr(src0_dsr_3, X_even_dsd);
        @load_to_dsr(src0_dsr_4, X_odd_dsd);

        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
        @fmulh(dest_dsr_2, src0_dsr_2, src1_dsr_2);
        @fmulh(dest_dsr_3, src0_dsr_3, src1_dsr_3);
        @fmulh(dest_dsr_4, src0_dsr_4, src1_dsr_4);

        @load_to_dsr(dest_dsr_5, X_even_dsd);
        @load_to_dsr(src0_dsr_5, X_tmp_1_dsd);
        @load_to_dsr(src1_dsr_5, X_tmp_2_dsd);
        @fsubh(dest_dsr_5, src0_dsr_5, src1_dsr_5);

        @load_to_dsr(dest_dsr_5, X_odd_dsd);
        @load_to_dsr(src0_dsr_5, X_tmp_3_dsd);
        @load_to_dsr(src1_dsr_5, X_tmp_4_dsd);
        @faddh(dest_dsr_5, src0_dsr_5, src1_dsr_5);

        X_even_dsd = @increment_dsd_offset(X_even_dsd, dim_p_pe, f16);
        X_odd_dsd = @increment_dsd_offset(X_odd_dsd, dim_p_pe, f16);
    }
}

fn xk_rope() void {
    X_even_dsd = @set_dsd_base_addr(X_even_dsd, ptr_QKV_tile);
    X_odd_dsd = @set_dsd_base_addr(X_odd_dsd, ptr_QKV_tile);
    X_even_dsd = @increment_dsd_offset(X_even_dsd, bsz*dim_p_pe, f16);
    X_odd_dsd = @increment_dsd_offset(X_odd_dsd, bsz*dim_p_pe, f16);

    @load_to_dsr(dest_dsr_1, X_tmp_1_dsd);
    @load_to_dsr(dest_dsr_2, X_tmp_2_dsd);
    @load_to_dsr(dest_dsr_3, X_tmp_3_dsd);
    @load_to_dsr(dest_dsr_4, X_tmp_4_dsd);

    @load_to_dsr(src1_dsr_1, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_2, freqs_sin_dsd);
    @load_to_dsr(src1_dsr_3, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_4, freqs_sin_dsd);

    for (@range(i16, bsz)) |b| {

        @load_to_dsr(src0_dsr_1, X_odd_dsd);
        @load_to_dsr(src0_dsr_2, X_even_dsd);
        @load_to_dsr(src0_dsr_3, X_even_dsd);
        @load_to_dsr(src0_dsr_4, X_odd_dsd);

        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
        @fmulh(dest_dsr_2, src0_dsr_2, src1_dsr_2);
        @fmulh(dest_dsr_3, src0_dsr_3, src1_dsr_3);
        @fmulh(dest_dsr_4, src0_dsr_4, src1_dsr_4);

        @load_to_dsr(dest_dsr_5, X_even_dsd);
        @load_to_dsr(src0_dsr_5, X_tmp_1_dsd);
        @load_to_dsr(src1_dsr_5, X_tmp_2_dsd);
        @fsubh(dest_dsr_5, src0_dsr_5, src1_dsr_5);

        @load_to_dsr(dest_dsr_5, X_odd_dsd);
        @load_to_dsr(src0_dsr_5, X_tmp_3_dsd);
        @load_to_dsr(src1_dsr_5, X_tmp_4_dsd);
        @faddh(dest_dsr_5, src0_dsr_5, src1_dsr_5);

        X_even_dsd = @increment_dsd_offset(X_even_dsd, dim_p_pe, f16);
        X_odd_dsd = @increment_dsd_offset(X_odd_dsd, dim_p_pe, f16);
    }
}

fn score_matvec_mult() void {
    // Zero all sub-head score entries
    for (@range(i16, gqa_group_size * bsz * seq_len_p_pe)) |i| { score[i] = 0.0; }

    ptr_right_matrix = &XKCache_tile;
    Kt = kv_dim_p_pe;
    Nt = seq_len_p_pe;

    // Phase 1: all gqa_group_size GEMVs — Q[g] @ K^T → score[g]  (no sync)
    // vecmat_computation() advances left_vector_dsd by bsz*Kt and out_vector_dsd by bsz*Nt per call.
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, &QKV_tile);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_score);
    for (@range(i16, gqa_group_size)) |_| {
        vecmat_computation();
    }

    // Snapshot 5a: after all GEMVs, before reduce (captures g=0 section)
    for (@range(i16, bsz * seq_len_p_pe)) |i| { score_post_gemv[i] = score[i]; }

    // Phase 2: ONE batched KV-head-scoped X-reduce over all gqa_group_size groups
    // (replaces gqa_group_size separate reduces)
    comm_mod.all_reduce_bsz_g_seq_len_kv_head_scoped(px_in_kv_head, quotient_x_in_kv_head, remainder_x, ptr_score);
    // simprint.print_string(" score_dsd post all reduce: ");
    // score_dsd = @set_dsd_base_addr(score_dsd, ptr_score);
    simprint_pe_coords_dsd(score_dsd);

    // Phase 3: alpha scale all groups  (no sync)
    score_dsd = @set_dsd_base_addr(score_dsd, ptr_score);
    for (@range(i16, gqa_group_size)) |_| {
        @load_to_dsr(dest_dsr_1, score_dsd);
        @load_to_dsr(src0_dsr_1, score_dsd);
        @fmulh(dest_dsr_1, src0_dsr_1, alpha);
        score_dsd = @increment_dsd_offset(score_dsd, bsz * seq_len_p_pe, f16);
    }
    score_dsd = @set_dsd_base_addr(score_dsd, ptr_score);
    // simprint.print_string(" score_dsd post alpha scale: ");
    // simprint_pe_coords_dsd(score_dsd);
    // simprint.print_string(" alpha: ");
    // simprint.print_f16(alpha);
    // simprint.print_string(" head_dim_p_pe: ");
    // simprint.print_u16_decimal(@as(u16, head_dim_p_pe));

    // Snapshot 5b: after reduce + alpha scale (captures g=0 section)
    for (@range(i16, bsz * seq_len_p_pe)) |i| { score_post_reduce[i] = score[i]; }
}

fn softmax_score() void {
    simprint.print_string("score_dsd pre softmax: ");
    simprint_pe_coords_dsd(score_dsd);

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    @load_to_dsr(src1_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        max = 0.0;
        @fmaxh(ptr_max, max, src1_dsr_1);
        local_max[b] = max;
    }
    
    comm_mod.all_reduceMax_bsz(py, quotient_y, remainder_y, ptr_local_max);

    simprint.print_string(" post all reduce max: ");
    simprint.print_f16(local_max[0]);

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score_tmp);
    seq_len_p_pe_dsd_2 = @set_dsd_base_addr(seq_len_p_pe_dsd_2, ptr_score);
    @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_2, .{ .save_address = true });
    @map(fsubh_func, local_max_dsd);

    // simprint.print_string(" score_dsd pre exp: ");
    // simprint_pe_coords_dsd(score_dsd);
    @map(fast_exp, score_tmp_dsd, score_dsd);
    simprint.print_string(" score_dsd post exp: ");
    simprint_pe_coords_dsd(score_dsd);
    // for (@range(i16, bsz*seq_len_p_pe)) |i| {
    //     score[i] = fast_exp(score_tmp[i]);
    // }

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    @load_to_dsr(src1_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        sum = 0.0;
        @faddh(ptr_sum, sum, src1_dsr_1);
        local_sum[b] = sum;
    }

    comm_mod.all_reduce_bsz(py, quotient_y, remainder_y, ptr_local_sum);

    simprint.print_string(" post all reduce sum: ");
    simprint.print_f16(local_sum[0]);

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @map(fmulh_softmax_func, local_sum_dsd);
    simprint.print_string(" score_dsd post softmax: ");
    simprint_pe_coords_dsd(score_dsd);
}

fn softmax_score_all_groups() void {
    // Step 1: local max for each group g, batch b → local_max_g[g*bsz + b]
    // Set base once to &score (whole-array ptr); save_address=true auto-advances by bsz*seq_len_p_pe per group.
    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    for (@range(i16, gqa_group_size)) |g| {
        @load_to_dsr(src1_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
        for (@range(i16, bsz)) |b| {
            max = 0.0;
            @fmaxh(ptr_max, max, src1_dsr_1);
            local_max_g[g * bsz + b] = max;
        }
        // save_address=true: seq_len_p_pe_dsd_1 auto-advances to next group after inner loop
    }

    // Step 2: ONE Y-reduce-max over gqa_group_size * bsz scalars
    comm_mod.all_reduceMax_bsz_g(py, quotient_y, remainder_y, &local_max_g);
    simprint.print_string(" local_max_g post all reduce: ");
    simprint_pe_coords_dsd(local_max_g_dsd);
    // Step 3: subtract global max + apply exp → score[g] in place (no sync)
    // seq_len_p_pe_dsd_2 set once; auto-advances via save_address=true.
    // seq_len_p_pe_dsd_1 reset inside loop (scratch buffer reused each group).
    // score_dsd and local_max_dsd do NOT auto-advance (@map, not DSR); use @increment_dsd_offset.
    seq_len_p_pe_dsd_2 = @set_dsd_base_addr(seq_len_p_pe_dsd_2, ptr_score);
    score_dsd = @set_dsd_base_addr(score_dsd, ptr_score);
    local_max_dsd = @set_dsd_base_addr(local_max_dsd, &local_max_g);
    for (@range(i16, gqa_group_size)) |_| {
        seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score_tmp);
        @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
        @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_2, .{ .save_address = true });
        @map(fsubh_func, local_max_dsd);
        @map(fast_exp, score_tmp_dsd, score_dsd);
        score_dsd = @increment_dsd_offset(score_dsd, bsz * seq_len_p_pe, f16);
        // score_tmp_dsd is NOT incremented: scratch buffer always rewritten at position 0
        local_max_dsd = @increment_dsd_offset(local_max_dsd, bsz, f16);
        // seq_len_p_pe_dsd_2 auto-advances to next group via save_address=true
    }

    score_dsd = @set_dsd_base_addr(score_dsd, ptr_score);
    score_dsd = @set_dsd_length(score_dsd, @bitcast(u16, gqa_group_size));
    simprint.print_string(" score_dsd post exp: ");
    simprint_pe_coords_dsd(score_dsd);

    // Step 4: local sum for each group g, batch b → local_sum_g[g*bsz + b]
    // Same pattern as Step 1: set base once, auto-advance per group.
    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    for (@range(i16, gqa_group_size)) |g| {
        @load_to_dsr(src1_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
        for (@range(i16, bsz)) |b| {
            sum = 0.0;
            @faddh(ptr_sum, sum, src1_dsr_1);
            local_sum_g[g * bsz + b] = sum;
        }
        // save_address=true: seq_len_p_pe_dsd_1 auto-advances to next group after inner loop
    }
    simprint.print_string(" score_dsd post exp: ");
    simprint_pe_coords_dsd(score_dsd);

    // Step 5: ONE Y-reduce-sum over gqa_group_size * bsz scalars
    comm_mod.all_reduce_bsz_g(py, quotient_y, remainder_y, &local_sum_g);
    simprint.print_string(" local_sum_g post all reduce: ");
    simprint_pe_coords_dsd(local_sum_g_dsd);
    // Step 6: divide each score[g] by its global sum (no sync)
    // seq_len_p_pe_dsd_1 set once; auto-advances via save_address=true (both dest and src0 DSRs).
    // local_sum_dsd does NOT auto-advance (@map); use @increment_dsd_offset.
    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    local_sum_dsd = @set_dsd_base_addr(local_sum_dsd, &local_sum_g);
    for (@range(i16, gqa_group_size)) |_| {
        simprint.print_string(" seq_len_p_pe_dsd_1: ");
        simprint_pe_coords_dsd(seq_len_p_pe_dsd_1);
        @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
        @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
        @map(fmulh_softmax_func, local_sum_dsd);
        local_sum_dsd = @increment_dsd_offset(local_sum_dsd, bsz, f16);
        seq_len_p_pe_dsd_1 = @increment_dsd_offset(seq_len_p_pe_dsd_1, bsz * seq_len_p_pe, f16);
    }
    simprint.print_string(" score_dsd after fmulh: ");
    simprint_pe_coords_dsd(score_dsd);
    // Restore local_max_dsd and local_sum_dsd base addresses for other callers
    local_max_dsd = @set_dsd_base_addr(local_max_dsd, ptr_local_max);
    local_sum_dsd = @set_dsd_base_addr(local_sum_dsd, ptr_local_sum);
}

fn output_matvec_mult_all_groups() void {
    // Set bases once using whole-array pointers (valid for @set_dsd_base_addr).
    // vecmat_computation() advances left_vector_dsd by bsz*Kt and out_vector_dsd by bsz*Nt
    // per call via its internal @increment_dsd_offset calls — exactly the per-group stride.
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_score);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_output);
    ptr_right_matrix = &XVCache_tile;
    Kt = seq_len_p_pe;
    Nt = kv_dim_p_pe;
    for (@range(i16, gqa_group_size)) |_| {
        vecmat_computation();
    }
    // Y-reduce is deferred: done once after all gqa_group_size output GEMVs (caller's responsibility)
}

fn o_matvec_mult() void {
    @fmovh(h1_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_output);
    
    ptr_right_matrix = &O_weight_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_h1);

    Kt = dim_p_pe;
    Nt = dim_p_pe;

    vecmat_computation();

    comm_mod.all_reduce_bsz_dim(px, quotient_x, remainder_x, ptr_h1);
}

fn attn_residual_add() void {
    @load_to_dsr(dest_dsr_1, Z_dsd);
    @load_to_dsr(src0_dsr_1, X_dsd);
    @load_to_dsr(src1_dsr_1, h1_dsd);
    @faddh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn rmsnorm_z() void {
    @load_to_dsr(dest_dsr_1, X_tmp_dsd);
    @load_to_dsr(src0_dsr_1, Z_dsd);
    @load_to_dsr(src1_dsr_1, Z_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    
    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_tmp);
    @load_to_dsr(src1_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        sum = 0.0;
        @faddh(ptr_sum, sum, src1_dsr_1);
        local_sum[b] = sum;
    }

    comm_mod.all_reduce_bsz(py, quotient_y, remainder_y, ptr_local_sum);

    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_z_norm);
    dim_p_pe_dsd_2 = @set_dsd_base_addr(dim_p_pe_dsd_2, ptr_X_tmp);
    @load_to_dsr(dest_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, dim_p_pe_dsd_2, .{ .save_address = true });
    @load_to_dsr(src1_dsr_1, W_dsd, .{ .save_address = false });
    for (@range(i16, bsz)) |b| {
        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    }

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_z_norm);
    @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @map(fmulh_norm_func, local_sum_dsd);
}

fn up_matvec_mult() void {
    @fmovh(z1_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z_norm);
    
    ptr_right_matrix = &UP_weight_tile;

    // out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_z1);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_ZZ_tile);

    Kt = dim_p_pe;
    Nt = ffn_dim_p_pe;

    vecmat_computation();

    // comm_mod.all_reduce_bsz_ffn_dim(py, quotient_y, remainder_y, ptr_z1);
}

fn gate_matvec_mult() void {
    @fmovh(z2_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z_norm);
    
    ptr_right_matrix = &GATE_weight_tile;

    // out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_z2);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_ZZ_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz * ffn_dim_p_pe, f16);

    Kt = dim_p_pe;
    Nt = ffn_dim_p_pe;

    vecmat_computation();

    // comm_mod.all_reduce_bsz_ffn_dim(py, quotient_y, remainder_y, ptr_z2);
}

fn silu_kernel(val: f16) f16 {
    return val / (1.0 + fast_exp(-val));
}

var z2_val: f16 = 0.0;
fn z2_silu() void {
    for (@range(i16, bsz*dim_p_pe)) |i| {
        z2_val = ZZ_tile[i];
        ZZ_tile[i] = z2_val / (1.0 + fast_exp(-z2_val));
    }
    // @map(silu_kernel, z2_dsd, z2_dsd);
}

fn z3_mat() void {
    @load_to_dsr(dest_dsr_1, z3_dsd);
    @load_to_dsr(src0_dsr_1, z1_dsd);
    @load_to_dsr(src1_dsr_1, z2_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn down_matvec_mult() void {
    @fmovh(h2_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z3);
    
    ptr_right_matrix = &DOWN_weight_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_h2);

    Kt = ffn_dim_p_pe;
    Nt = dim_p_pe;

    vecmat_computation();

    comm_mod.all_reduce_bsz_dim(px, quotient_x, remainder_x, ptr_h2);
}

fn ffn_residual_add() void {
    @load_to_dsr(dest_dsr_1, Z_dsd);
    @load_to_dsr(src0_dsr_1, Z_dsd);
    @load_to_dsr(src1_dsr_1, h2_dsd);
    @faddh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn decode_struct() void {

    rmsnorm_x();

    xq_matvec_mult();
    xk_matvec_mult();
    xv_matvec_mult();
    // Snapshot 1: local partial GEMV result (before Y-reduce)
    for (@range(i16, bsz * (dim_p_pe + 2 * kv_dim_p_pe))) |i| { QKV_post_proj[i] = QKV_tile[i]; }

    comm_mod.all_reduce_bsz_dim_QKV_fusion(py, quotient_y, remainder_y, ptr_QKV_tile);
    // Snapshot 2: after Y-reduce, before RoPE
    for (@range(i16, bsz * (dim_p_pe + 2 * kv_dim_p_pe))) |i| { QKV_post_reduce[i] = QKV_tile[i]; }

    comm_mod.reconfig_allreduce_axis(3); // 3: kv-head-scoped X (pes_p_kv_head PEs per KV-head)

    // xq_rope();  // TODO: RoPE disabled — strided-DSD @fmulh bug under investigation
    // xk_rope();

    score_matvec_mult();  // gqa_group_size GEMVs + kv-head-scoped reduces inside

    comm_mod.reconfig_allreduce_axis(1);

    @fmovh(output_dsd, 0.0);
    softmax_score_all_groups();       // 2 Y-reduces total (1 max + 1 sum), batched over all groups
    output_matvec_mult_all_groups();  // G local GEMVs, no sync
    // Single Y-reduce covers all gqa_group_size sub-head outputs (full output_tile)
    comm_mod.all_reduce_bsz_dim(py, quotient_y, remainder_y, ptr_output);

    comm_mod.reconfig_allreduce_axis(0);

    o_matvec_mult();

    attn_residual_add();

    comm_mod.reconfig_allreduce_axis(1);

    rmsnorm_z();

    up_matvec_mult();
    gate_matvec_mult();
    comm_mod.all_reduce_bsz_ffn_dim_ZZ_fusion(py, quotient_y, remainder_y, ptr_ZZ_tile);

    z2_silu();

    z3_mat();

    comm_mod.reconfig_allreduce_axis(0);

    down_matvec_mult();

    ffn_residual_add();

    comm_mod.reconfig_allreduce_axis(1);

    decode_entry();
}

fn exit() void {
    timestamp.get_timestamp(&tsc_end_buf);
    timestamp.disable_tsc();

    f_reference_timestamps();
    f_memcpy_timestamps();
    sys_mod.unblock_cmd_stream();
}


// -------------------------------------------------------------------------- //
// ------------------------------ Entry Point ----------------------------- //
// -------------------------------------------------------------------------- //
var total_repeat_times: i16 = 1;
var total_warmup_times: i16 = 0;
var repeat_times: i16 = 0; // Start from 0

fn decode_host(total_warmup_times_: i16, total_repeat_times_: i16) void {
    total_warmup_times = total_warmup_times_;
    total_repeat_times = total_repeat_times_;
    repeat_times = 0;

    decode_entry();
}

fn decode_entry() void {
    // Run (total_warmup_times + total_repeat_times) times; only the last `total_repeat_times` iterations are timed
    if (repeat_times == total_warmup_times + total_repeat_times) {
        exit();
    } else {
        if (repeat_times == total_warmup_times) {
            timestamp.get_timestamp(&tsc_ref_buf);
            timestamp.get_timestamp(&tsc_start_buf);
        }

        repeat_times += 1;
        decode_struct();
    }
}


// -------------------------------------------------------------------------- //
// ------------------------------- Timer Funcs ------------------------------ //
// -------------------------------------------------------------------------- //

fn f_memcpy_timestamps() void {
    var lo_ : u16 = 0;
    var hi_ : u16 = 0;
    var word : u32 = 0;

    lo_ = tsc_start_buf[0];
    hi_ = tsc_start_buf[1];
    timer_buf[0] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = tsc_start_buf[2];
    hi_ = tsc_end_buf[0];
    timer_buf[1] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = tsc_end_buf[1];
    hi_ = tsc_end_buf[2];
    timer_buf[2] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );
}

fn f_reference_timestamps() void {
    var lo_ : u16 = 0;
    var hi_ : u16 = 0;

    lo_ = tsc_ref_buf[0];
    hi_ = tsc_ref_buf[1];
    time_ref_f32[0] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = tsc_ref_buf[2];
    hi_ = 0;
    time_ref_f32[1] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );
}

// -------------------------------------------------------------------------- //
// ------------------------------ Compile-time ------------------------------ //
// -------------------------------------------------------------------------- //

comptime {
    @export_symbol(ptr_X, "X");
    @export_symbol(ptr_W, "W");
    @export_symbol(ptr_Q_weight, "Q_weight");
    @export_symbol(ptr_K_weight, "K_weight");
    @export_symbol(ptr_V_weight, "V_weight");
    @export_symbol(ptr_freqs_sin, "freqs_sin");
    @export_symbol(ptr_freqs_cos, "freqs_cos");
    @export_symbol(ptr_XKCache, "XKCache");
    @export_symbol(ptr_XVCache, "XVCache");
    @export_symbol(ptr_O_weight, "O_weight");
    @export_symbol(ptr_UP_weight, "UP_weight");
    @export_symbol(ptr_GATE_weight, "GATE_weight");
    @export_symbol(ptr_DOWN_weight, "DOWN_weight");
}

comptime {
    @export_symbol(init_task, "init_task");
    @export_symbol(decode_host, "decode_host");
}

comptime {
    @export_symbol(ptr_timer_buf, "timer_buf");
    @export_symbol(ptr_time_ref, "time_ref");
    @export_symbol(ptr_debug, "debug");
}

comptime {
    // Intermediate buffers exported for host-side validation
    @export_symbol(ptr_QKV_post_proj,   "QKV_post_proj");     // after projection, before Y-reduce
    @export_symbol(ptr_QKV_post_reduce, "QKV_post_reduce");   // after Y-reduce, before RoPE
    @export_symbol(ptr_QKV_tile, "QKV_tile");                 // post-RoPE Q/K/V  [bsz*(dim_p_pe+2*kv_dim_p_pe)]
    @export_symbol(ptr_score_post_gemv,   "score_post_gemv"); // after GEMV, before head reduce [bsz*seq_len_p_pe]
    @export_symbol(ptr_score_post_reduce, "score_post_reduce"); // after reduce+alpha, before softmax [bsz*seq_len_p_pe]
    @export_symbol(ptr_score, "score");                       // post-softmax attn [bsz*seq_len_p_pe]
    @export_symbol(ptr_output, "output_tile");                // post-output-matmul [bsz*dim_p_pe]
}